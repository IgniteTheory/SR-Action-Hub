// Phase 1 schema. Targets Postgres for fast local development.
// To move to SQL Server: change `provider` below to "sqlserver" and point
// DATABASE_URL at the real instance, then re-run `prisma migrate dev`.
// The schema avoids Postgres-only features so the move is a config change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  STAFF
}

enum CommunicationSource {
  PHONE
  EMAIL
  WHATSAPP
  WALK_IN
  TEAMS
  INTERNAL
  OTHER
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum Turnaround {
  URGENT
  HOURS_2_3
  TODAY
  DAY_1
  DAYS_2_3
  WEEK_1
  CUSTOM
  CUSTOM_DATE
}

enum ActionStatus {
  NEW
  ALLOCATED
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_SARS
  WAITING_BANK
  WAITING_THIRD_PARTY
  SNOOZED
  COMPLETED
  CANCELLED
}

// How a Request Type's quote step works when an Action is created against it.
enum QuoteBehavior {
  NEVER  // routine ad-hoc work, no quote involved
  MANUAL // Stephan must draw up and send a quote himself (new/unpriced work)
  AUTO   // a price is on file; the system drafts a quote and tracks client approval
}

enum QuoteStatus {
  NOT_NEEDED
  NEEDS_MANUAL_QUOTE
  NEEDS_INTERNAL_APPROVAL // AUTO-priced quote drafted, waiting on Stephan to approve before the client sees it
  PENDING_APPROVAL
  ACCEPTED
  DECLINED
}

model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  passwordHash          String
  role                  Role     @default(STAFF)
  colour                String   @default("#1f7a4d")
  active                Boolean  @default(true)
  requiresTimesheetCheck Boolean @default(false)
  createdAt             DateTime @default(now())

  createdActions    Action[]        @relation("CreatedBy")
  assignedActions   Action[]        @relation("AssignedTo")
  statusChanges     StatusHistory[]
  accountantClients Client[]        @relation("AssignedAccountant")
  actionNotes       ActionNote[]

  @@map("users")
}

model Client {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  entityType           String?
  active               Boolean  @default(true)
  registrationNr       String?
  vatNr                String?
  taxNr                String?
  payeNr               String?
  notes                String?
  grading              String?
  director1            String?
  assignedAccountantId Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignedAccountant User?     @relation("AssignedAccountant", fields: [assignedAccountantId], references: [id])
  contacts           Contact[]
  actions            Action[]

  @@map("clients")
}

model Contact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  actions Action[]

  @@map("contacts")
}

model RequestType {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  isActive      Boolean       @default(true)
  quoteBehavior QuoteBehavior @default(NEVER)
  price         Decimal?      @db.Decimal(10, 2)

  actions Action[]

  @@map("request_types")
}

model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("ticket_counters")
}

model Action {
  id                    Int       @id @default(autoincrement())
  ticketNumber          String    @unique

  clientId              Int
  contactId             Int?
  contactPerson         String
  telephone              String?
  email                 String?

  communicationSource   CommunicationSource
  requestTypeId         Int
  otherRequestDetail    String?

  description           String

  assignedToId          Int?
  priority              Priority   @default(NORMAL)
  turnaround             Turnaround @default(TODAY)
  customTurnaroundHours  Int?
  dueAt                  DateTime

  status                ActionStatus @default(NEW)

  snoozeUntil            DateTime?
  snoozeReason           String?

  sendAcknowledgement    Boolean    @default(false)
  acknowledgementEmailSentAt DateTime?
  acknowledgementEmailError  String?

  quoteStatus            QuoteStatus @default(NOT_NEEDED)
  quoteAmount             Decimal?   @db.Decimal(10, 2)
  // Manually entered by staff — what the client is actually being quoted
  // for. Kept separate from the ticket's own `description` (its origin/
  // intake reason) since the two can diverge once a fee is worked out.
  quoteDescription        String?
  quoteToken              String?    @unique
  quoteRespondedAt        DateTime?
  quoteEmailSentAt        DateTime?
  quoteEmailError         String?
  quoteBilled             Boolean    @default(false)

  addedToTimesheet       Boolean    @default(false)

  completionEmailSentAt  DateTime?
  completionEmailError   String?

  createdById            Int
  createdAt              DateTime   @default(now())
  updatedAt               DateTime  @updatedAt
  completedAt             DateTime?
  deletedAt               DateTime?
  deletedById              Int?

  // Set on both sides when a "needs a quote" ticket auto-creates a duplicate
  // for the client's assigned accountant to prep in parallel — see the
  // create-action logic in actions.ts.
  linkedActionId          Int?

  client       Client       @relation(fields: [clientId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  requestType  RequestType  @relation(fields: [requestTypeId], references: [id])
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id])
  linkedAction Action?      @relation("LinkedAction", fields: [linkedActionId], references: [id])
  linkedFrom   Action[]     @relation("LinkedAction")

  statusHistory StatusHistory[]
  subtasks      ActionSubtask[]
  notes         ActionNote[]

  @@map("actions")
}

model ActionSubtask {
  id        Int      @id @default(autoincrement())
  actionId  Int
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_subtasks")
}

model ActionNote {
  id          Int      @id @default(autoincrement())
  actionId    Int
  text        String
  createdById Int
  createdAt   DateTime @default(now())

  action    Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@map("action_notes")
}

model StatusHistory {
  id          Int          @id @default(autoincrement())
  actionId    Int
  fromStatus  ActionStatus?
  toStatus    ActionStatus
  changedById Int
  changedAt   DateTime     @default(now())
  note        String?

  action    Action @relation(fields: [actionId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@map("status_history")
}
