# For local development, point at a Postgres instance (see README).
# To go live against SQL Server: change `provider` in prisma/schema.prisma
# to "sqlserver" and set DATABASE_URL to your SQL Server connection string,
# then run `npm run prisma:migrate`.
DATABASE_URL="postgresql://sraction:sraction_dev_pw@localhost:5432/sr_action_hub"

# Generate a real random secret before deploying anywhere real users can reach.
JWT_SECRET="change-me"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Outbound/inbound email via Microsoft Graph, sending/reading as the fixed
# ticketing@sraccounting.co.za shared mailbox. Certificate-based app-only
# auth only — never a client secret. See README.md "Email via Microsoft
# Graph" for how to obtain and install these locally and in production.
# All values below are placeholders; the real thumbprint/tenant/client IDs
# come from whoever provisioned the Entra app registration, and the private
# key is never committed or passed as a plain env var value — only as a
# path to a file supplied through a protected secret mechanism.
MS_TENANT_ID="00000000-0000-0000-0000-000000000000"
MS_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MS_SHARED_MAILBOX="ticketing@sraccounting.co.za"
MS_CERTIFICATE_THUMBPRINT="0000000000000000000000000000000000000"
MS_CERTIFICATE_PRIVATE_KEY_PATH="/run/secrets/sr_action_hub_graph_private_key.pem"

# Optional — shown in the sign-off line of outbound emails. Defaults to
# "SR Accounting" if unset.
MAIL_FROM_NAME="SR Accounting"
