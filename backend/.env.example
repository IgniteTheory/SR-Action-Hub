# For local development, point at a Postgres instance (see README).
# To go live against SQL Server: change `provider` in prisma/schema.prisma
# to "sqlserver" and set DATABASE_URL to your SQL Server connection string,
# then run `npm run prisma:migrate`.
DATABASE_URL="postgresql://sraction:sraction_dev_pw@localhost:5432/sr_action_hub"

# Generate a real random secret before deploying anywhere real users can reach.
JWT_SECRET="change-me"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
